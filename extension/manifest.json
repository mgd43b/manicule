{
  "manifest_version": 3,
  "name": "manicule session handoff",
  "version": "1.0.0",
  "description": "Hands the Confluence session in this browser to a manicule server running on this machine.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "manicule session handoff" }
}
